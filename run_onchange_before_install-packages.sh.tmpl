#!/bin/bash
set -euo pipefail
{{- if eq .chezmoi.os "darwin" }}
[ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ] \
  || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- else }}
command -v apt-get >/dev/null || { echo "only apt-based Linux is supported" >&2; exit 1; }
SUDO=""; [ "$(id -u)" -eq 0 ] || SUDO=sudo
# apt-packages.txt hash: {{ include "apt-packages.txt" | sha256sum }}
$SUDO apt-get update -qq
mapfile -t apt_packages < {{ joinPath .chezmoi.sourceDir "apt-packages.txt" | quote }}
DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y -qq "${apt_packages[@]}" >/dev/null
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] \
  || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- end }}
for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$brew_bin" ]; then eval "$("$brew_bin" shellenv)"; break; fi
done
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
export DOTFILES_GUI={{ if .gui }}1{{ else }}0{{ end }}
brew bundle --no-upgrade --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
