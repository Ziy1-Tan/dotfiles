#!/bin/bash
set -euo pipefail
[ "$(basename "${SHELL:-}")" = zsh ] && exit 0
SUDO=""; [ "$(id -u)" -eq 0 ] || SUDO=sudo
# Homebrew's zsh isn't in /etc/shells, so chsh would refuse it on macOS.
{{ if eq .chezmoi.os "darwin" -}}
$SUDO chsh -s /bin/zsh "$(id -un)"
{{- else -}}
$SUDO chsh -s "$(command -v zsh)" "$(id -un)"
{{- end }}
