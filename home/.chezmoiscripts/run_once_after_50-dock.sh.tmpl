{{ if and (eq .chezmoi.os "darwin") .gui -}}
#!/bin/bash
set -euo pipefail
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$brew_bin" ]; then eval "$("$brew_bin" shellenv)"; break; fi
done

# dockutil exits 0 for a missing app and leaves a dead icon, so test first.
add() {
  if [ -e "$1" ]; then dockutil --add "$1" --no-restart; else echo "dock: skipping missing $1" >&2; fi
}
gap() { dockutil --add '' --type small-spacer --section apps --no-restart; }

# run_once because the Dock gets hand-tuned afterwards and must not be wiped.
# Start from empty so the result doesn't depend on the previous Dock.
dockutil --remove all --no-restart

add "/System/Applications/System Settings.app"
add "/System/Applications/Music.app"
add "/Applications/QQMusic.app"
add "/Applications/Google Chrome.app"
gap
add "/Applications/TT switch.app"
add "/Applications/Visual Studio Code.app"
add "/Applications/Ghostty.app"
gap
add "/Applications/WeChat.app"
add "/Applications/QQ.app"
add "/Applications/Obsidian.app"

killall Dock
{{ end -}}
