#!/usr/bin/env bash

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

# ── Only prompt for sudo when root is actually needed ──────────
# Mirrors the guards in install.conf.yaml: if nothing this run needs root
# (apt / usermod / chsh / installing brew), the password prompt is skipped.
needs_sudo() {
    # Linux: apt install zsh/curl
    if [ "$(uname)" = "Linux" ] && { ! command -v zsh >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; }; then
        return 0
    fi
    # Installing Homebrew (its installer uses sudo internally)
    if ! command -v brew >/dev/null 2>&1; then
        return 0
    fi
    # Switching the default shell to zsh
    if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
        return 0
    fi
    # Linux: apt install fd
    if [ "$(uname)" = "Linux" ] && ! command -v fd >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

SUDO_KEEPER_PID=""
if needs_sudo; then
    # Reuse an existing valid sudo cache instead of prompting
    if ! sudo -n true 2>/dev/null; then
        echo "Please enter your sudo password (needed for system setup):"
        sudo -v
    fi
    # Keep the sudo credential alive for the whole run (dotbot has no TTY, so the
    # password can't be entered from inside the yaml)
    ( while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) &
    SUDO_KEEPER_PID=$!
    trap 'kill "$SUDO_KEEPER_PID" 2>/dev/null' EXIT
fi

git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"
