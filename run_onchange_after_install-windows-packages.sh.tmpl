{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) -}}
#!/bin/bash
set -euo pipefail

# winget.json hash: {{ include "winget.json" | sha256sum }}
# scoop.json hash: {{ include "scoop.json" | sha256sum }}

src={{ .chezmoi.sourceDir | quote }}

PS=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
[ -x "$PS" ] || PS=powershell.exe
status=0

if "$PS" -NoProfile -Command 'Get-Command winget -ErrorAction SilentlyContinue' >/dev/null 2>&1; then
  "$PS" -NoProfile -Command \
    "winget import --import-file '$(wslpath -w "$src/winget.json")' \
      --accept-package-agreements --accept-source-agreements \
      --ignore-unavailable --no-upgrade" || status=$?
else
  echo "winget not found; skipping Windows apps" >&2
fi

if "$PS" -NoProfile -Command \
    'if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) { exit 1 }'; then
  "$PS" -NoProfile -ExecutionPolicy Bypass \
    -Command "scoop import '$(wslpath -w "$src/scoop.json")'" || status=$?
else
  echo "scoop not found; skipping scoop packages" >&2
fi

exit "$status"
{{- end -}}
